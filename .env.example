# Required for account, session, saved-opportunity, report and analysis-history storage.
# Use one variable only. Vercel's Neon integration provides POSTGRES_URL automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# POSTGRES_URL=provided_automatically_by_vercel_neon

# Set by Vercel automatically in deployed environments. Use development locally.
NODE_ENV=development

# Required only when password-reset email delivery is enabled in a future integration.
APP_URL=http://localhost:3000
EMAIL_FROM=security@example.com

# Server-only bootstrap identity. The matching account becomes admin after a successful login.
NMI_OWNER_EMAIL=owner@example.com
